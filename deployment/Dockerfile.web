# Rebuild only the Next.js frontend and layer it onto the running image.
#
# The app ships as a compiled Next.js standalone bundle inside /app/web, so a
# source change cannot be applied by editing files at runtime. Build this from
# the repository root, where both `src/` (the v1.7.2 source tree) and `deploy/`
# are visible:
#
#   docker build -f deploy/Dockerfile.web -t deeptutor-local:1.7.2-photo .
#
# BASE must be the image that already carries the local patches (Manim venv,
# Chromium, hidden signup, GeoGebra compat, OpenAI defaults). Only /app/web is
# replaced here, so those layers survive.
ARG BASE=deeptutor-local:1.7.2-no-signup-manim
ARG NPM_REGISTRY=https://registry.npmjs.org

FROM node:22.23.4-slim AS web-builder
ARG NPM_REGISTRY

WORKDIR /app/web

COPY src/web/package.json src/web/package-lock.json ./
RUN npm config set registry "${NPM_REGISTRY}" \
    && npm config set fetch-timeout 600000 \
    && npm config set fetch-retries 5 \
    && npm ci --legacy-peer-deps

COPY src/web/ ./
# next.config.js inlines the version at build time.
COPY src/deeptutor/__version__.py /app/deeptutor/__version__.py
RUN printf 'NEXT_PUBLIC_APP_VERSION=\n' > .env.local && npm run build

FROM ${BASE}

# Drop the previous bundle first: leaving old content-addressed chunks behind a
# new build is how you get half-hydrated pages in a long-lived tab.
RUN rm -rf /app/web

COPY --from=web-builder /app/web/.next/standalone/ /app/web/
COPY --from=web-builder /app/web/.next/static/ /app/web/.next/static/
COPY --from=web-builder /app/web/public/ /app/web/public/

# Both patches rewrite compiled chunks, so a frontend rebuild wipes them. They
# must be replayed against the new output, in this order, or the deployment
# silently re-exposes the register link and loses GeoGebra compatibility.
COPY deploy/disable-registration.mjs deploy/geogebra-compat.js \
     deploy/patch-geogebra.mjs deploy/verify-geogebra.mjs /tmp/
RUN node /tmp/disable-registration.mjs \
    && node /tmp/patch-geogebra.mjs \
    && node /tmp/verify-geogebra.mjs \
    && rm /tmp/disable-registration.mjs /tmp/geogebra-compat.js \
          /tmp/patch-geogebra.mjs /tmp/verify-geogebra.mjs

RUN chown -R deeptutor:deeptutor /app/web

LABEL local.deeptutor.frontend="photo-capture"
