FROM ghcr.io/hkuds/deeptutor:1.7.2@sha256:9b8b21ea8861434868ba20adf70966ad9dce193c507c2dcceffbe57264306da8

# The upstream image sets HOME per supervised process. Keep npm/browser caches in the
# existing writable data volume, including sandboxed video-lesson subprocesses.
RUN sed -i 's|HOME="/home/deeptutor"|HOME="/app/data"|g' /etc/supervisor/conf.d/programs.conf

# Keep this narrowly scoped patch reproducible without rebuilding the full app.
# The script fails if the pinned release no longer has the expected structure.
COPY deployment/disable-registration.mjs /tmp/disable-registration.mjs
RUN node /tmp/disable-registration.mjs && rm /tmp/disable-registration.mjs

LABEL local.deeptutor.registration="disabled"

# Manim needs native drawing libraries and TeX as well as its Python package.
# Include XeLaTeX/Chinese support for Chinese lesson text and mathematical labels.
ARG DEBIAN_MIRROR=https://mirrors.cloud.tencent.com
RUN sed -i "s|https://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential cmake pkg-config libcairo2-dev libpango1.0-dev libffi-dev \
        libegl1 libgl1 ffmpeg dvisvgm chromium chromium-sandbox \
        texlive-latex-extra texlive-fonts-recommended texlive-science \
        texlive-xetex texlive-lang-chinese \
    && rm -rf /var/lib/apt/lists/*

# Keep the add-on in a venv while reusing the base image's DeepTutor dependencies.
# The backend and its Manim subprocess both use this interpreter through PATH.
RUN python -m venv --system-site-packages /opt/deeptutor-venv
ENV VIRTUAL_ENV=/opt/deeptutor-venv
ENV PATH="/opt/deeptutor-venv/bin:${PATH}"
ARG MANIM_VERSION=0.22.1
RUN python -m pip install --no-cache-dir --prefer-binary \
        --index-url https://mirrors.cloud.tencent.com/pypi/simple \
        -r /app/requirements/math-animator.txt "manim==${MANIM_VERSION}" \
    && python -c "import manim; print('Manim', manim.__version__)"

# Python's bundled venv seed is older than llama-index-core requires.
RUN python -m pip install --no-cache-dir \
        --index-url https://mirrors.cloud.tencent.com/pypi/simple "setuptools==80.9.0" \
    && python -m pip check

COPY deployment/geogebra-compat.js deployment/patch-geogebra.mjs deployment/verify-geogebra.mjs /tmp/
RUN node /tmp/patch-geogebra.mjs && node /tmp/verify-geogebra.mjs \
    && rm /tmp/geogebra-compat.js /tmp/patch-geogebra.mjs /tmp/verify-geogebra.mjs

COPY deployment/patch-openai-defaults.mjs deployment/verify-openai-defaults.py /tmp/
RUN node /tmp/patch-openai-defaults.mjs \
    && PYTHONPATH=/app /opt/deeptutor-venv/bin/python /tmp/verify-openai-defaults.py \
    && rm /tmp/patch-openai-defaults.mjs /tmp/verify-openai-defaults.py

COPY --chmod=755 deployment/deeptutor-chromium /usr/local/bin/deeptutor-chromium
ENV DEEPTUTOR_CHROME_EXECUTABLE=/usr/local/bin/deeptutor-chromium
